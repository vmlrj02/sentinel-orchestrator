# --- Required ---
OPENAI_API_KEY=
# From @BotFather. Leave empty to run web-only.
TELEGRAM_TOKEN=

# --- Observability (optional; tracing is off without keys) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- Models ---
OPENAI_MODEL=gpt-5.4-mini
FALLBACK_MODEL=gpt-5-mini
# fake = deterministic, no API calls (tests, load tests)
LLM_PROVIDER=openai

# --- Runtime ---
ENVIRONMENT=local
CHECKPOINTER=sqlite
SQLITE_PATH=data/sentinel.db
TELEGRAM_MODE=polling
# Required when TELEGRAM_MODE=webhook
TELEGRAM_WEBHOOK_SECRET=
# Comma-separated chat IDs allowed on Telegram (empty = anyone)
ALLOWED_CHAT_IDS=

# --- Guards ---
MAX_CONCURRENT_TURNS=50
RATE_LIMIT_PER_MINUTE=20
TURN_TIMEOUT_S=60
MAX_MESSAGE_CHARS=1000
